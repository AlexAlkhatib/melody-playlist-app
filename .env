# ─────────────────────────────────────────────────────────────────────────────
# Melody — variables d'environnement par défaut (DEV)
#
# Ordre de chargement (le dernier gagne) :
#   .env  →  .env.local  →  .env.$APP_ENV  →  .env.$APP_ENV.local  →  variables système
#
# ⚠️  Ce fichier est versionné : n'y mettez JAMAIS de secrets réels.
#     Utilisez `.env.local` (ignoré par git) en local, ou les variables
#     d'environnement du conteneur / de la plateforme en production.
# ─────────────────────────────────────────────────────────────────────────────

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
# Changez cette valeur en production : `php -r "echo bin2hex(random_bytes(16));"`
APP_SECRET=6f1c9d2b8a4e7c50b3d9f6a1e8c47b52
###< symfony/framework-bundle ###

# URL publique de l'application (utilisée pour les emails et les liens absolus)
APP_URL=http://localhost:8000

###> doctrine/doctrine-bundle ###
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE?serverVersion=X.Y&charset=utf8mb4
DATABASE_URL="mysql://melody:melody@127.0.0.1:3306/melody?serverVersion=8.0.36&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# En dev : `null://null` n'envoie rien (les mails sont écrits dans var/log/dev.log).
# Pour tester visuellement : MAILER_DSN=smtp://127.0.0.1:1025 (Mailpit / Mailcatcher).
MAILER_DSN=null://null
MAILER_FROM="Melody <no-reply@melody.local>"
CONTACT_TO_EMAIL=contact@melody.local
###< symfony/mailer ###

###> vich/uploader-bundle ###
# Taille maximale des fichiers uploadés (octets) — 20 Mo
UPLOAD_MAX_AUDIO_SIZE=20971520
###< vich/uploader-bundle ###
