{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Changer mon mot de passe — {{ app_name }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="page-head__sub"><a class="muted" href="{{ path('app_profile') }}">← Mon profil</a></p>
            <h1 class="page-head__title">Changer mon mot de passe</h1>
        </div>
    </div>

    <div class="split">
        <div>
            {{ form_start(form, {attr: {class: 'form-grid', novalidate: 'novalidate'}}) }}
                <div class="panel form-grid">
                    {% for child in form %}
                        {% if child.vars.name not in ['_token', 'submit'] %}
                            <div class="field">{{ form_row(child) }}</div>
                        {% endif %}
                    {% endfor %}
                    <div class="form-actions">
                        {{ form_row(form.submit) }}
                        <a class="btn btn--ghost" href="{{ path('app_profile') }}">Annuler</a>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>

        <aside class="panel">
            <div class="panel__head">
                <h2 class="panel__title">Bon réflexe</h2>
            </div>
            <p class="small muted">
                Utilisez au moins 8 caractères, avec majuscules, minuscules et chiffres.
                Vous resterez connecté après la modification.
            </p>
        </aside>
    </div>
{% endblock %}
