{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Créer un compte — {{ app_name }}{% endblock %}

{% block body %}
    <div class="auth">
        <section class="auth__art">
            <span class="auth__orb" aria-hidden="true"></span>
            <h2>Votre bibliothèque musicale commence ici.</h2>
            <p>Catalogue partagé, playlists illimitées, lecteur continu — sans publicité.</p>
        </section>

        <section class="auth__card">
            <h1 class="auth__title">Créer un compte</h1>
            <p class="auth__sub">Quelques secondes suffisent.</p>

            {{ form_start(registrationForm, {attr: {class: 'form-grid', novalidate: 'novalidate'}}) }}
                {% for child in registrationForm %}
                    {% if child.vars.name not in ['_token', 'submit'] %}
                        <div class="field">{{ form_row(child) }}</div>
                    {% endif %}
                {% endfor %}

                {{ form_row(registrationForm.submit) }}
            {{ form_end(registrationForm) }}

            <p class="auth__footer">
                Déjà inscrit ? <a href="{{ path('app_login') }}">Connectez-vous</a>
            </p>
        </section>
    </div>
{% endblock %}
