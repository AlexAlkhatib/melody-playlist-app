<div class="player is-idle" id="player">
    <div class="player__track">
        <div class="cover cover--0 player__cover" id="player-cover" aria-hidden="true"></div>
        <div class="player__info">
            <div class="player__title" id="player-title">Aucun titre en lecture</div>
            <div class="player__artist" id="player-artist">Choisissez un morceau dans le catalogue</div>
        </div>
    </div>

    <div class="player__controls">
        <div class="player__buttons">
            <button class="player__btn" type="button" id="player-shuffle"
                    aria-label="Lecture aléatoire" aria-pressed="false">
                <svg width="17" height="17" aria-hidden="true"><use href="#i-shuffle"/></svg>
            </button>
            <button class="player__btn" type="button" id="player-prev" aria-label="Titre précédent">
                <svg width="18" height="18" aria-hidden="true"><use href="#i-prev"/></svg>
            </button>
            <button class="player__btn player__btn--main" type="button" id="player-play" aria-label="Lire">
                <svg width="20" height="20" aria-hidden="true"><use href="#i-play"/></svg>
            </button>
            <button class="player__btn" type="button" id="player-next" aria-label="Titre suivant">
                <svg width="18" height="18" aria-hidden="true"><use href="#i-next"/></svg>
            </button>
            <button class="player__btn" type="button" id="player-repeat"
                    aria-label="Répétition désactivée" aria-pressed="false">
                <svg width="17" height="17" aria-hidden="true"><use href="#i-repeat"/></svg>
            </button>
        </div>

        <div class="player__timeline">
            <span class="player__time" id="player-current">0:00</span>
            <input class="range" id="player-seek" type="range" min="0" max="100" step="0.1" value="0"
                   aria-label="Position de lecture" style="--p:0%">
            <span class="player__time" id="player-duration">0:00</span>
        </div>
    </div>

    <div class="player__extra">
        <button class="player__btn" type="button" id="player-mute" aria-label="Couper le son">
            <svg width="17" height="17" aria-hidden="true"><use href="#i-volume"/></svg>
        </button>
        <input class="range player__volume" id="player-volume" type="range" min="0" max="1" step="0.01"
               value="0.8" aria-label="Volume" style="--p:80%">
        <a class="player__btn" id="player-link" href="#" aria-label="Ouvrir la fiche du morceau">
            <svg width="17" height="17" aria-hidden="true"><use href="#i-arrow-right"/></svg>
        </a>
    </div>
</div>
