{% import 'partials/_ui.html.twig' as ui %}

<form class="inline-form" method="post" action="{{ path('morceaux.delete', {id: morceaux.id}) }}"
      onsubmit="return confirm('Supprimer définitivement « {{ morceaux.nomMorceaux|e('js') }} » ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete-morceaux-' ~ morceaux.id) }}">
    <button class="btn btn--danger btn--sm" type="submit">
        {{ ui.icon('trash', 15) }} Supprimer
    </button>
</form>
