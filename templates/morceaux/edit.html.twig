{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Modifier {{ morceaux.nomMorceaux }} — {{ app_name }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="page-head__sub">
                <a href="{{ path('morceaux.show', {id: morceaux.id}) }}" class="muted">← {{ morceaux.nomMorceaux }}</a>
            </p>
            <h1 class="page-head__title">Modifier le morceau</h1>
        </div>
    </div>

    <div class="split">
        <div>
            {{ include('morceaux/_form.html.twig', {cancel: path('morceaux.show', {id: morceaux.id})}) }}
        </div>

        <aside class="panel">
            <div class="panel__head">
                <h2 class="panel__title">Aperçu</h2>
                <p class="panel__sub">Rendu dans le catalogue</p>
            </div>
            {{ ui.trackCard(morceaux) }}
            <div class="mt-2">
                {{ include('morceaux/_delete_form.html.twig') }}
            </div>
        </aside>
    </div>
{% endblock %}
