{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Explorer le catalogue — {{ app_name }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Explorer</h1>
            <p class="page-head__sub">{{ morceaux.getTotalItemCount }} morceau(x) dans le catalogue partagé</p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--primary" href="{{ path('morceaux.new') }}">
                {{ ui.icon('plus', 17) }} Ajouter un morceau
            </a>
        </div>
    </div>

    <form method="get" action="{{ path('morceaux.index') }}" role="search" class="mt-0">
        <div class="search" style="max-width:none">
            <svg width="17" height="17" aria-hidden="true"><use href="#i-search"/></svg>
            <label class="sr-only" for="catalog-search">Rechercher dans le catalogue</label>
            <input type="search" id="catalog-search" name="q" value="{{ q }}"
                   placeholder="Titre, artiste, genre…" autocomplete="off">
        </div>
    </form>

    <div class="chips mt-2">
        <a class="chip{{ q is empty ? ' is-active' }}" href="{{ path('morceaux.index') }}">Tous</a>
        {% for genre in genres %}
            <a class="chip{{ q == genre.nomGenre ? ' is-active' }}"
               href="{{ path('morceaux.index', {q: genre.nomGenre}) }}">{{ genre.nomGenre }}</a>
        {% endfor %}
    </div>

    {% if morceaux is empty %}
        <div class="empty mt-3">
            {{ ui.icon('search', 30) }}
            <strong>Aucun morceau ne correspond{% if q %} à « {{ q }} »{% endif %}</strong>
            <p>Essayez un autre titre, un autre artiste ou un autre genre.</p>
            {% if q %}<a class="btn btn--soft btn--sm" href="{{ path('morceaux.index') }}">Réinitialiser la recherche</a>{% endif %}
        </div>
    {% else %}
        <div class="grid-tracks mt-3" data-queue>
            {% for morceau in morceaux %}
                {{ ui.trackCard(morceau) }}
            {% endfor %}
        </div>

        <div class="mt-2">
            <button class="btn btn--soft" type="button" data-play-all>
                {{ ui.icon('play', 16) }} Lire cette sélection
            </button>
        </div>

        {{ knp_pagination_render(morceaux, 'partials/_pagination.html.twig') }}
    {% endif %}
{% endblock %}
