{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Ajouter un morceau — {{ app_name }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Ajouter un morceau</h1>
            <p class="page-head__sub">Renseignez les informations, puis joignez la pochette et l'audio.</p>
        </div>
    </div>

    <div class="split">
        <div>
            {{ include('morceaux/_form.html.twig') }}
        </div>

        <aside class="panel">
            <div class="panel__head">
                <h2 class="panel__title">Conseils</h2>
                <p class="panel__sub">Quelques repères avant publication</p>
            </div>
            <div class="stack-sm small muted">
                <p>• Formats audio acceptés : MP3, OGG, WAV, FLAC, AAC (20 Mo maximum).</p>
                <p>• Pochette : JPG, PNG ou WebP, 2 Mo maximum — carrée de préférence.</p>
                <p>• Le morceau rejoint le catalogue partagé et reste modifiable par son auteur.</p>
            </div>
        </aside>
    </div>
{% endblock %}
