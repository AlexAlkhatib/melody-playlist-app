{% import 'partials/_ui.html.twig' as ui %}
{% set cancelUrl = cancel is defined ? cancel : path('app_playlist_index') %}

{{ form_start(form) }}
<div class="panel form-grid">
    {% for child in form %}
        {% if child.vars.name not in ['_token', 'submit'] %}
            <div class="field{{ child.vars.name == 'morceauxid' ? ' field--choices' }}">{{ form_row(child) }}</div>
        {% endif %}
    {% endfor %}

    <div class="form-actions">
        {{ form_row(form.submit) }}
        <a class="btn btn--ghost" href="{{ cancelUrl }}">Annuler</a>
    </div>
</div>
{{ form_end(form) }}
