{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Modifier {{ playlist.nomPlaylist }} — {{ app_name }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="page-head__sub">
                <a href="{{ path('app_playlist_show', {id: playlist.id}) }}" class="muted">← {{ playlist.nomPlaylist }}</a>
