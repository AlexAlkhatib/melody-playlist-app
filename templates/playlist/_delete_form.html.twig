{% import 'partials/_ui.html.twig' as ui %}

<form method="post" action="{{ path('app_playlist_delete', {id: playlist.id}) }}" class="inline-form"
      onsubmit="return confirm('Supprimer définitivement « {{ playlist.nomPlaylist|e('js') }} » ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete-playlist-' ~ playlist.id) }}">
    <button class="btn btn--danger btn--sm" type="submit">{{ ui.icon('trash', 15) }} Supprimer</button>
</form>
