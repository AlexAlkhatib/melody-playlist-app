{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}{{ playlist.nomPlaylist }} — {{ app_name }}{% endblock %}

{% block body %}
    <div data-queue>
        <div class="playlist-hero">
            <div class="mosaic">
                {% set tracks = playlist.morceauxid|slice(0, 4) %}
                {% for i in 0..3 %}
                    {% set track = tracks[i] is defined ? tracks[i] : null %}
                    {{ ui.cover(track ? track.id : loop.index + playlist.id, track and track.imageName ? vich_uploader_asset(track, 'imageFile') : null) }}
                {% endfor %}
            </div>

            <div>
                <div class="detail__eyebrow">Playlist</div>
                <h1 class="playlist-hero__title">{{ playlist.nomPlaylist }}</h1>
                <p class="playlist-hero__sub">
                    {{ playlist.morceauxid|length }} morceau(x) ·
                    créée par {{ playlist.userid ? playlist.userid.nomComplet : '—' }}
                </p>

                <div class="playlist-hero__actions">
                    {% if playlist.morceauxid is not empty %}
                        <button class="btn btn--primary" type="button" data-play-all>
                            {{ ui.icon('play', 17) }} Tout lire
                        </button>
                    {% endif %}
                    {% if playlist.isOwnedBy(app.user) %}
                        <a class="btn btn--soft" href="{{ path('app_playlist_edit', {id: playlist.id}) }}">{{ ui.icon('edit', 16) }} Modifier</a>
                        {{ include('playlist/_delete_form.html.twig') }}
                    {% endif %}
                </div>
            </div>
        </div>

        {% if playlist.morceauxid is empty %}
            <div class="empty">
                {{ ui.icon('library', 30) }}
                <strong>Cette playlist est vide</strong>
                <p>Ajoutez des morceaux du catalogue pour lui donner vie.</p>
                <a class="btn btn--primary btn--sm" href="{{ path('app_playlist_edit', {id: playlist.id}) }}">Ajouter des morceaux</a>
            </div>
        {% else %}
            <div class="track-list">
                {% for morceau in playlist.morceauxid %}
                    {{ ui.trackRow(morceau) }}
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="mt-3">
        <a class="btn btn--ghost" href="{{ path('app_playlist_index') }}">{{ ui.icon('arrow-left', 16) }} Mes playlists</a>
    </div>
{% endblock %}
