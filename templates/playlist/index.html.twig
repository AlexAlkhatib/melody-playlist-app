{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Mes playlists — {{ app_name }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Mes playlists</h1>
            <p class="page-head__sub">{{ playlists.getTotalItemCount }} playlist(s) dans votre bibliothèque</p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--primary" href="{{ path('app_playlist_new') }}">{{ ui.icon('plus', 17) }} Créer une playlist</a>
        </div>
    </div>

    <div class="grid-playlists">
        {% for playlist in playlists %}
            <article class="playlist-card">
                <a href="{{ path('app_playlist_show', {id: playlist.id}) }}">
                    <div class="mosaic">
                        {% set tracks = playlist.morceauxid|slice(0, 4) %}
                        {% for i in 0..3 %}
                            {% set track = tracks[i] is defined ? tracks[i] : null %}
                            {{ ui.cover(track ? track.id : loop.index + playlist.id, track and track.imageName ? vich_uploader_asset(track, 'imageFile') : null) }}
                        {% endfor %}
                    </div>
                    <div class="playlist-card__title">{{ playlist.nomPlaylist }}</div>
                    <div class="playlist-card__meta">{{ playlist.morceauxid|length }} morceau(x) · {{ playlist.userid ? playlist.userid.nomComplet : '—' }}</div>
                </a>
                <div class="form-actions mt-1">
                    <a class="btn btn--soft btn--sm" href="{{ path('app_playlist_edit', {id: playlist.id}) }}">{{ ui.icon('edit', 14) }} Modifier</a>
                    {{ include('playlist/_delete_form.html.twig') }}
                </div>
            </article>
        {% endfor %}

        <a class="playlist-card playlist-card--new" href="{{ path('app_playlist_new') }}">
            {{ ui.icon('plus', 28) }}
            <span>Nouvelle playlist</span>
        </a>
    </div>

    {{ knp_pagination_render(playlists, 'partials/_pagination.html.twig') }}
{% endblock %}
