# Environnement de test : base SQLite jetable, aucun mail réel, kernel explicite.
KERNEL_CLASS=App\Kernel
APP_ENV=test
APP_SECRET=test-secret-not-for-production
APP_DEBUG=1

# La connexion de test est définie dans config/packages/doctrine.yaml (when@test) :
# driver SQLite3 natif + fichier var/test.db recréé à chaque exécution.
MAILER_DSN=null://null
MAILER_FROM="Melody <no-reply@melody.test>"
CONTACT_TO_EMAIL=contact@melody.test
